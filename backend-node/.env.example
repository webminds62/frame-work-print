NODE_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:8081

# Supabase: the service-role key stays on the server only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Use sandbox for testing; use the live URL only with a live Prodigi key.
PRODIGI_API_KEY=
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com
PRODIGI_DEFAULT_SHIPPING=Budget
PRODIGI_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://YOUR_PUBLIC_API_HOST

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
