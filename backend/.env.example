# Local/test configuration only. Never commit real secret values.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=frameworks_prints_dev
JWT_SECRET=replace-with-at-least-32-random-characters

# Stripe test mode. Keep sk_test values server-side only.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

PUBLIC_BASE_URL=https://api.example.test
CORS_ORIGINS=https://app.example.test
ADMIN_EMAIL=
ADMIN_PASSWORD=
APPLE_AUDIENCES=com.yourcompany.frameworksprints
# AI previews default to free local demo mode. Set false only when intentionally
# testing paid cloud image generation with the server-side key below.
AI_DEMO_MODE=true
AI_DAILY_CLOUD_LIMIT=3
AI_CACHE_TTL_HOURS=24
AI_IMAGE_MODEL=openai/gpt-image-1
AI_IMAGE_QUALITY=low
OPENAI_API_KEY=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Frame Works Prints


# Prodigi Print API (sandbox default). Get a free key at https://www.prodigi.com/
PRODIGI_API_KEY=
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com
PRODIGI_MARKUP=1.6
PRODIGI_DEFAULT_SHIPPING=Budget
PRODIGI_WEBHOOK_SECRET=replace-with-a-random-callback-token
# Keep false until PUBLIC_BASE_URL is HTTPS and you are ready to submit sandbox orders.
PRODIGI_SUBMIT_ORDERS=false
