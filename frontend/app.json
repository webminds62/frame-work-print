{
  "expo": {
    "name": "Frame Works Prints",
    "slug": "frame-works-prints",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frameworksprints",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.aiteedesigner.m7zqpa",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Take a photo to turn into wall art",
        "NSPhotoLibraryUsageDescription": "Choose a photo to turn into wall art"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F9F7"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.aiteedesigner.m7zqpa",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to turn into wall art",
          "cameraPermission": "Take a photo to turn into wall art"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F9F7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
